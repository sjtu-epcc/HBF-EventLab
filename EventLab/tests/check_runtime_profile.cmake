file(MAKE_DIRECTORY "${OUT}")
execute_process(COMMAND "${BENCH}" 2 2 RESULT_VARIABLE rc OUTPUT_VARIABLE off ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "disabled benchmark: ${err}")
endif()
execute_process(COMMAND "${BENCH}" 2 2 "${OUT}/profile.json" RESULT_VARIABLE rc OUTPUT_VARIABLE on ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "enabled benchmark: ${err}")
endif()
string(JSON off REMOVE "${off}" program_wall_ns)
string(JSON on REMOVE "${on}" program_wall_ns)
if(NOT off STREQUAL on)
    message(FATAL_ERROR "profile changed deterministic benchmark results")
endif()
file(READ "${OUT}/profile.json" profile)
string(JSON peak GET "${profile}" counters results_size_peak)
string(JSON registered GET "${profile}" counters registered_fragments)
string(JSON generated GET "${profile}" counters split_fragments)
string(JSON visits GET "${profile}" counters results_entries_visited)
string(JSON scans GET "${profile}" regions results_scan calls)
string(JSON checks GET "${profile}" regions completion_check calls)
string(JSON advances GET "${profile}" regions advance calls)
if(NOT visits EQUAL 0 OR NOT scans EQUAL 0 OR NOT checks GREATER 0 OR NOT checks EQUAL advances)
    message(FATAL_ERROR "history scan was not replaced by aggregate checks")
endif()
if(NOT peak EQUAL 6 OR NOT registered EQUAL 384 OR NOT generated GREATER registered)
    message(FATAL_ERROR "unexpected history/fragment counters: ${peak}, ${registered}, ${generated}")
endif()
# All ordinary output protection applies to the new CLI diagnostic path.
file(WRITE "${OUT}/input.txt" "HBF_EVENTLAB_WORKLOAD 1\nWRITE 1 0 4096 content=1\n")
# Use the existing known-good workload for execution, a disposable file for collision checks.
execute_process(COMMAND "${CLI}" "${SOURCE}/examples/workloads/normal.txt" --runtime-profile "${OUT}/cli.json" RESULT_VARIABLE rc OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "profile CLI: ${stderr}")
endif()
execute_process(COMMAND "${CLI}" "${SOURCE}/examples/workloads/normal.txt" RESULT_VARIABLE rc OUTPUT_VARIABLE plain ERROR_VARIABLE stderr)
if(NOT rc EQUAL 0 OR NOT stdout STREQUAL plain)
    message(FATAL_ERROR "profiling changed CLI output: ${stderr}")
endif()
file(READ "${OUT}/cli.json" cli_profile)
string(JSON calls GET "${cli_profile}" regions split calls)
if(NOT calls GREATER 0)
    message(FATAL_ERROR "CLI did not instrument split")
endif()
foreach(other "${OUT}/input.txt" "${OUT}/duplicate.json")
    execute_process(COMMAND "${CLI}" "${OUT}/input.txt" --runtime-profile "${other}" --stats-json "${OUT}/duplicate.json" RESULT_VARIABLE rc ERROR_VARIABLE stderr)
    if(NOT rc EQUAL 5 OR NOT stderr MATCHES "overwrite|differ")
        message(FATAL_ERROR "output collision not rejected: ${stderr}")
    endif()
endforeach()
