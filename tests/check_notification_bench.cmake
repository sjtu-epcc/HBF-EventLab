file(MAKE_DIRECTORY "${OUT}")
execute_process(COMMAND "${BENCH}" 2 2 2 - "${OUT}/off.jsonl" RESULT_VARIABLE rc OUTPUT_VARIABLE off ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "unprofiled notification benchmark: ${err}")
endif()
execute_process(COMMAND "${BENCH}" 2 2 2 "${OUT}/profile.json" "${OUT}/on.jsonl" RESULT_VARIABLE rc OUTPUT_VARIABLE on ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "profiled notification benchmark: ${err}")
endif()
string(JSON off REMOVE "${off}" program_wall_ns)
string(JSON on REMOVE "${on}" program_wall_ns)
if(NOT off STREQUAL on)
    message(FATAL_ERROR "diagnostics changed deterministic result")
endif()
file(SHA256 "${OUT}/off.jsonl" off_hash)
file(SHA256 "${OUT}/on.jsonl" on_hash)
if(NOT off_hash STREQUAL on_hash)
    message(FATAL_ERROR "diagnostics changed observable event stream")
endif()
file(READ "${OUT}/profile.json" p)
string(JSON rearms GET "${p}" counters read_rearms)
string(JSON space_callbacks GET "${p}" wait_reasons result_space callbacks)
string(JSON device_pumps GET "${p}" regions device_pump calls)
if(NOT rearms EQUAL 0 OR NOT space_callbacks EQUAL 0 OR NOT device_pumps GREATER 0)
    message(FATAL_ERROR "unrelated read wakeups persist or Device diagnostics absent")
endif()
