execute_process(COMMAND "${PROGRAM}" "${WORKLOAD}" --stats-json "${OUTPUT}" ${ARGS}
    RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
if(NOT "${result}" STREQUAL "${EXPECTED}")
    message(FATAL_ERROR "exit=${result}, expected=${EXPECTED}\n${stdout}\n${stderr}")
endif()
file(READ "${OUTPUT}" json)
string(JSON schema GET "${json}" schema_version)
string(JSON stop GET "${json}" stop_reason)
string(JSON globals LENGTH "${json}" globals)
string(JSON work LENGTH "${json}" logical_work)
string(JSON attempts LENGTH "${json}" attempts)
if(NOT schema EQUAL 1 OR NOT globals EQUAL 3 OR NOT work EQUAL 256)
    message(FATAL_ERROR "invalid schema or lost original workload")
endif()
if(EXPECTED EQUAL 0)
    string(JSON write_count GET "${json}" summary attempts write success)
    string(JSON read_count GET "${json}" summary attempts read success)
    string(JSON samples GET "${json}" summary latency "write.attempt.success.accepted_response" count)
    if(NOT stop STREQUAL "Completed" OR NOT attempts EQUAL 256 OR NOT samples EQUAL 128
       OR NOT write_count EQUAL 128 OR NOT read_count EQUAL 128)
        message(FATAL_ERROR "unexpected completed measurement counts")
    endif()
    math(EXPR last "${attempts} - 1")
    foreach(i RANGE 0 ${last})
        string(JSON handoff GET "${json}" attempts ${i} handoff)
        string(JSON rx GET "${json}" attempts ${i} rx_arrival)
        string(JSON accepted GET "${json}" attempts ${i} accepted)
        string(JSON delivered GET "${json}" attempts ${i} delivered)
        string(JSON work_count LENGTH "${json}" attempts ${i} work_ids)
        if(handoff GREATER rx OR rx GREATER accepted OR accepted GREATER delivered OR NOT work_count EQUAL 1)
            message(FATAL_ERROR "invalid five-boundary ordering or origin")
        endif()
    endforeach()
    # Exercise the output guard on a disposable input, never the repository file.
    file(READ "${WORKLOAD}" original)
    set(copy "${OUTPUT}.input.txt")
    file(WRITE "${copy}" "${original}")
    execute_process(COMMAND "${PROGRAM}" "${copy}" --stats-json "${copy}"
        RESULT_VARIABLE guard_exit OUTPUT_VARIABLE guard_out ERROR_VARIABLE guard_error)
    file(READ "${copy}" preserved)
    if(NOT guard_exit EQUAL 5 OR NOT preserved STREQUAL original)
        message(FATAL_ERROR "statistics output corrupted its workload input")
    endif()
else()
    string(JSON accepted_type TYPE "${json}" attempts 0 accepted)
    string(JSON pending GET "${json}" summary globals write pending)
    if(NOT stop STREQUAL "LimitReached" OR NOT accepted_type STREQUAL "NULL" OR NOT pending EQUAL 2)
        message(FATAL_ERROR "partial run fabricated completion/milestone")
    endif()
endif()
message(STATUS "Statistics JSON parsed and verified: ${stop}")
