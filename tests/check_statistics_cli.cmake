execute_process(COMMAND "${PROGRAM}" "${WORKLOAD}" --stats-json "${OUTPUT}" ${ARGS}
    RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
if(NOT "${result}" STREQUAL "${EXPECTED}")
    message(FATAL_ERROR "exit=${result}, expected=${EXPECTED}\n${stdout}\n${stderr}")
endif()
file(READ "${OUTPUT}" json)
string(JSON schema GET "${json}" schema_version)
string(JSON stop GET "${json}" stop_reason)
string(JSON globals LENGTH "${json}" globals)
string(JSON work LENGTH "${json}" logical_work)
string(JSON attempts LENGTH "${json}" attempts)
string(JSON contexts LENGTH "${json}" dlu_contexts)
string(JSON channels LENGTH "${json}" pending_channels)
string(JSON timeline GET "${json}" pending_timeline)
if(NOT schema EQUAL 2 OR NOT globals EQUAL 3 OR NOT work EQUAL 256)
    message(FATAL_ERROR "invalid schema or lost original workload")
endif()
if(EXPECTED EQUAL 0)
    string(JSON write_count GET "${json}" summary attempts write success)
    string(JSON read_count GET "${json}" summary attempts read success)
    string(JSON samples GET "${json}" summary latency "write.attempt.success.accepted_response" count)
    if(NOT stop STREQUAL "Completed" OR NOT attempts EQUAL 256 OR NOT samples EQUAL 128
       OR NOT write_count EQUAL 128 OR NOT read_count EQUAL 128)
        message(FATAL_ERROR "unexpected completed measurement counts")
    endif()
    math(EXPR last "${attempts} - 1")
    foreach(i RANGE 0 ${last})
        string(JSON handoff GET "${json}" attempts ${i} handoff)
        string(JSON rx GET "${json}" attempts ${i} rx_arrival)
        string(JSON accepted GET "${json}" attempts ${i} accepted)
        string(JSON delivered GET "${json}" attempts ${i} delivered)
        string(JSON work_count LENGTH "${json}" attempts ${i} work_ids)
        if(handoff GREATER rx OR rx GREATER accepted OR accepted GREATER delivered OR NOT work_count EQUAL 1)
            message(FATAL_ERROR "invalid five-boundary ordering or origin")
        endif()
    endforeach()
    if(NOT contexts EQUAL 2 OR NOT channels EQUAL 2)
        message(FATAL_ERROR "lost per-channel Pending lifecycle")
    endif()
    foreach(ch RANGE 0 1)
        string(JSON current GET "${json}" pending_channels ${ch} current total)
        string(JSON opened GET "${json}" pending_channels ${ch} opened)
        string(JSON retired GET "${json}" pending_channels ${ch} retired)
        string(JSON area GET "${json}" pending_channels ${ch} area_context_ticks total)
        string(JSON residence GET "${json}" dlu_contexts ${ch} residence_ticks)
        string(JSON members LENGTH "${json}" dlu_contexts ${ch} members)
        string(JSON fragments GET "${json}" dlu_contexts ${ch} received_fragments)
        string(JSON reason GET "${json}" dlu_contexts ${ch} termination)
        if(NOT current EQUAL 0 OR NOT opened EQUAL 1 OR NOT retired EQUAL 1 OR NOT area EQUAL residence
           OR NOT members EQUAL 64 OR NOT fragments EQUAL 64 OR NOT reason STREQUAL "program_success")
            message(FATAL_ERROR "inconsistent Pending summary/context export")
        endif()
    endforeach()
    string(JSON point_count LENGTH "${timeline}")
    math(EXPR last_point "${point_count} - 1")
    set(previous_sequence 0)
    foreach(i RANGE 0 ${last_point})
        string(JSON point GET "${timeline}" ${i})
        string(JSON sequence GET "${point}" sequence)
        foreach(field total collecting ready_waiting programming)
            string(JSON ${field} GET "${point}" counts ${field})
        endforeach()
        math(EXPR sum "${collecting}+${ready_waiting}+${programming}")
        if(NOT total EQUAL sum OR NOT sequence GREATER previous_sequence)
            message(FATAL_ERROR "invalid curve partition or same-Tick order")
        endif()
        set(previous_sequence ${sequence})
    endforeach()
    # Exercise the output guard on a disposable input, never the repository file.
    file(READ "${WORKLOAD}" original)
    set(copy "${OUTPUT}.input.txt")
    file(WRITE "${copy}" "${original}")
    execute_process(COMMAND "${PROGRAM}" "${copy}" --stats-json "${copy}"
        RESULT_VARIABLE guard_exit OUTPUT_VARIABLE guard_out ERROR_VARIABLE guard_error)
    file(READ "${copy}" preserved)
    if(NOT guard_exit EQUAL 5 OR NOT preserved STREQUAL original)
        message(FATAL_ERROR "statistics output corrupted its workload input")
    endif()
elseif(MODE STREQUAL "assembly_limit")
    string(JSON active GET "${json}" dlu_contexts 0 active)
    string(JSON retired_type TYPE "${json}" dlu_contexts 0 retired_at)
    string(JSON ready_type TYPE "${json}" dlu_contexts 0 ready_at)
    string(JSON fragments GET "${json}" dlu_contexts 0 received_fragments)
    string(JSON collecting GET "${json}" pending_channels 0 current collecting)
    if(NOT stop STREQUAL "LimitReached" OR contexts LESS 1 OR NOT active OR NOT retired_type STREQUAL "NULL"
       OR NOT ready_type STREQUAL "NULL" OR fragments LESS 1 OR fragments GREATER_EQUAL 64 OR NOT collecting EQUAL 1)
        message(FATAL_ERROR "active assembly fabricated retirement or lost progress")
    endif()
else()
    string(JSON accepted_type TYPE "${json}" attempts 0 accepted)
    string(JSON pending GET "${json}" summary globals write pending)
    if(NOT stop STREQUAL "LimitReached" OR NOT accepted_type STREQUAL "NULL" OR NOT pending EQUAL 2 OR NOT contexts EQUAL 0)
        message(FATAL_ERROR "partial run fabricated completion/milestone")
    endif()
endif()
message(STATUS "Statistics JSON parsed and verified: ${stop}")
