# Tiny configure-only projects exercise dependency handling without a C++ compiler.
file(MAKE_DIRECTORY "${TEST_ROOT}/source")
file(WRITE "${TEST_ROOT}/source/CMakeLists.txt"
    "cmake_minimum_required(VERSION 3.20)\nproject(ExperimentDependency NONE)\ninclude(\"${SOURCE_ROOT}/cmake/ExperimentPython.cmake\")\nhbf_eventlab_find_experiment_python()\n")
foreach(mode missing disabled available)
    set(args)
    if(mode STREQUAL "available")
        list(APPEND args "-DPython3_EXECUTABLE=${PYTHON_EXECUTABLE}")
    else()
        list(APPEND args "-DCMAKE_DISABLE_FIND_PACKAGE_Python3=TRUE")
    endif()
    if(mode STREQUAL "disabled")
        list(APPEND args "-DHBF_EVENTLAB_EXPERIMENT_TESTS=OFF")
    else()
        list(APPEND args "-DHBF_EVENTLAB_EXPERIMENT_TESTS=ON")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -S "${TEST_ROOT}/source" -B "${TEST_ROOT}/${mode}"
                    ${args} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(mode STREQUAL "missing")
        if(result EQUAL 0 OR NOT "${output}${error}" MATCHES "require Python 3.10")
            message(FATAL_ERROR "Missing Python was not an explicit failure: ${output}${error}")
        endif()
    elseif(NOT result EQUAL 0)
        message(FATAL_ERROR "${mode} configuration failed: ${output}${error}")
    elseif(mode STREQUAL "disabled" AND NOT output MATCHES "explicitly disabled")
        message(FATAL_ERROR "Explicit opt-out was not reported")
    endif()
endforeach()
