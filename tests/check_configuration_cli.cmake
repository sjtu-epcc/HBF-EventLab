file(MAKE_DIRECTORY "${CASE_DIR}")
set(config "${CASE_DIR}/input.ini")
set(effective "${CASE_DIR}/effective.ini")
set(stats "${CASE_DIR}/stats.json")
set(input "${WORKLOAD}")
set(expected 5)
set(args "")
set(text "")
if(CASE STREQUAL "precedence")
    file(WRITE "${config}" "[device.capabilities]\nmocs_supported=1024\n[device.selected]\nmocs_selected=512\n[host]\nmax_open_dlus_per_channel=4\n[execution.read_dispatch]\nthreshold=7\n")
    # --config location does not change precedence; aliases and --set are ordered.
    set(args --mocs 256 --config "${config}" --set device.selected.mocs_selected=512 --mocs 1024 --dump-config "${effective}")
    set(expected 0)
    set(text "mocs=1024 mocs_supported=1024")
elseif(CASE STREQUAL "roundtrip")
    set(args --dump-config "${effective}" --stats-json "${stats}")
    set(expected 0)
    set(text "STOP Completed workload=Success")
elseif(CASE STREQUAL "invalid_grade")
    set(args --channels 16 --speed-grade 1)
    set(text "speed grade module limit")
elseif(CASE STREQUAL "invalid_mocs")
    set(args --mocs 300)
    set(text "device.selected.mocs_selected")
elseif(CASE STREQUAL "unknown")
    set(args --set execution.ucie.effective_gbytes_per_second=94)
    set(text "derived-only")
elseif(CASE STREQUAL "duplicate")
    file(WRITE "${config}" "[host]\nmax_open_dlus_per_channel=3\nmax_open_dlus_per_channel=4\n")
    set(args --config "${config}")
    set(text "duplicate field")
elseif(CASE STREQUAL "policy")
    set(args --set host.send_policy=not_implemented)
    set(text "host.send_policy")
elseif(CASE STREQUAL "host_default" OR CASE STREQUAL "host_fill_open" OR CASE STREQUAL "host_override")
    set(host_policy "fcfs")
    set(args --dump-config "${effective}")
    if(CASE STREQUAL "host_fill_open")
        set(host_policy "fill_open")
        file(WRITE "${config}" "[host]\nsend_policy=fill_open\n")
        list(APPEND args --config "${config}")
    elseif(CASE STREQUAL "host_override")
        file(WRITE "${config}" "[host]\nsend_policy=fill_open\n")
        list(APPEND args --config "${config}" --set host.send_policy=fcfs)
    endif()
    set(expected 0)
    set(text "host_policy=${host_policy}")
elseif(CASE STREQUAL "buffer")
    set(args --set execution.buffers.ingress_payload_bytes=1)
    set(text "ingress_payload_bytes")
elseif(CASE STREQUAL "collision")
    set(args --stats-json "${effective}" --dump-config "${effective}")
    set(text "different files")
elseif(CASE STREQUAL "workload_guard")
    file(READ "${WORKLOAD}" original)
    set(input "${CASE_DIR}/copy.txt")
    file(WRITE "${input}" "${original}")
    set(args --dump-config "${input}")
    set(text "must not overwrite")
elseif(CASE STREQUAL "config_guard")
    set(original "[host]\nmax_open_dlus_per_channel=4\n")
    file(WRITE "${config}" "${original}")
    set(args --config "${config}" --dump-config "${config}")
    set(text "must not overwrite")
elseif(CASE STREQUAL "read_small")
    set(input "${CASE_DIR}/read.txt")
    file(WRITE "${input}" "HBF_EVENTLAB_WORKLOAD 1\nREAD 1 0 64\n")
    set(args --channels 1 --mocs 1 --set device.capabilities.write_burst=false)
    set(expected 2) # UnwrittenPage is a real read response, not invalid configuration.
    set(text "STOP Completed workload=FailedOrUnfinished")
elseif(CASE STREQUAL "write_small" OR CASE STREQUAL "burst_small")
    set(input "${CASE_DIR}/write.txt")
    file(WRITE "${input}" "HBF_EVENTLAB_WORKLOAD 1\nWRITE 1 0 4096 content=1\n")
    set(args --channels 1 --mocs 1 --timeout-retries 0)
    if(CASE STREQUAL "burst_small")
        list(APPEND args --burst)
        set(expected 0)
        set(text "STOP Completed workload=Success")
    else()
        list(APPEND args --set device.capabilities.write_burst=false)
        set(expected 2)
        set(text "WRITE_CREDIT_INSUFFICIENT")
    endif()
endif()
execute_process(COMMAND "${PROGRAM}" "${input}" ${args} RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
if(NOT "${result}" STREQUAL "${expected}" OR NOT "${stdout}\n${stderr}" MATCHES "${text}")
    message(FATAL_ERROR "${CASE}: exit=${result}, expected=${expected}, text=${text}\n${stdout}\n${stderr}")
endif()
if(CASE MATCHES "^host_")
    file(READ "${effective}" content)
    if(NOT content MATCHES "send_policy = \"${host_policy}\"")
        message(FATAL_ERROR "effective configuration lost the selected Host policy")
    endif()
elseif(CASE STREQUAL "precedence")
    file(READ "${effective}" content)
    if(NOT content MATCHES "threshold = 7" OR NOT content MATCHES "max_open_dlus_per_channel = 4")
        message(FATAL_ERROR "omitted CLI options overwrote file parameters")
    endif()
elseif(CASE STREQUAL "roundtrip")
    file(READ "${stats}" first)
    execute_process(COMMAND "${PROGRAM}" "${input}" --config "${effective}" --dump-config "${CASE_DIR}/again.ini"
        RESULT_VARIABLE replay OUTPUT_VARIABLE again ERROR_VARIABLE replay_error)
    file(READ "${stats}" second)
    if(NOT replay EQUAL 0 OR NOT first STREQUAL second)
        message(FATAL_ERROR "effective config replay changed simulation output: ${again} ${replay_error}")
    endif()
elseif(CASE STREQUAL "workload_guard")
    file(READ "${input}" preserved)
    if(NOT preserved STREQUAL original)
        message(FATAL_ERROR "input workload was modified")
    endif()
elseif(CASE STREQUAL "config_guard")
    file(READ "${config}" preserved)
    if(NOT preserved STREQUAL original)
        message(FATAL_ERROR "input config was modified")
    endif()
elseif(CASE STREQUAL "read_small" OR CASE STREQUAL "burst_small")
    if(stderr MATCHES "WRITE_CREDIT_INSUFFICIENT")
        message(FATAL_ERROR "incorrect write-credit warning")
    endif()
endif()
message(STATUS "Configuration CLI ${CASE} passed")
