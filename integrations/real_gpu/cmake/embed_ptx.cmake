if(NOT DEFINED SYMBOL)
  set(SYMBOL embedded_ptx_helper)
endif()
file(READ "${INPUT}" PTX_TEXT)
file(WRITE "${OUTPUT}" "#pragma once\n#include <string>\nnamespace hbflab { inline const std::string ${SYMBOL} = [] { std::string text;\n")
string(LENGTH "${PTX_TEXT}" PTX_LENGTH)
set(OFFSET 0)
while(OFFSET LESS PTX_LENGTH)
  string(SUBSTRING "${PTX_TEXT}" ${OFFSET} 8000 CHUNK)
  file(APPEND "${OUTPUT}" "text += R\"HBF_HELPER(${CHUNK})HBF_HELPER\";\n")
  math(EXPR OFFSET "${OFFSET} + 8000")
endwhile()
file(APPEND "${OUTPUT}" "return text; }(); }\n")
