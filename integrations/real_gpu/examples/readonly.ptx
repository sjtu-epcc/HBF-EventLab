// Uninstrumented application PTX. No HBFLab symbols or device helper calls.
.version 8.0
.target sm_75
.address_size 64
.visible .entry read_and_add(.param .u64 input, .param .u64 output) {
    .reg .u32 %r<3>;
    .reg .u64 %rd<5>;
    ld.param.u64 %rd0, [input];
    ld.param.u64 %rd1, [output];
    mov.u32 %r0, %tid.x;
    mul.wide.u32 %rd2, %r0, 4;
    add.u64 %rd3, %rd0, %rd2;
    add.u64 %rd4, %rd1, %rd2;
    ld.global.u32 %r1, [%rd3];
    add.u32 %r2, %r1, 7;
    st.global.u32 [%rd4], %r2;
    ret;
}
